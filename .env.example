# ─────────────────────────────────────────────────────────────────────────────
# SYLTRA repository environment template — PLACEHOLDERS ONLY, NEVER REAL VALUES.
# Copy to .env (platform) / .env.local (website); both are gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Website (Next.js) ──
# Sina (the SYNTRA SMART site assistant) calls the Anthropic API server-side.
# Get a key at https://console.anthropic.com/ and put it in .env.local (never commit that file).
ANTHROPIC_API_KEY=
# Optional — defaults to a fast, cost-effective model if unset.
SINA_MODEL=claude-haiku-4-5-20251001

# ── SYLTRA Adaptive Edge Platform ──

# Identity
SYLTRA_HOME_ID=home_dev_001
SYLTRA_HUB_ID=hub_dev_001
SYLTRA_ENVIRONMENT=development   # development | pilot — development blocks real critical actuators

# Home Assistant (Phase 1+)
# Create a long-lived access token in the HA user profile; paste it in .env only.
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=changeme-long-lived-access-token

# NATS JetStream
NATS_URL=nats://localhost:4222
NATS_USER=syltra
NATS_PASSWORD=changeme

# PostgreSQL / TimescaleDB
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=syltra
POSTGRES_USER=syltra
POSTGRES_PASSWORD=changeme

# MQTT (Eclipse Mosquitto)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=syltra
MQTT_PASSWORD=changeme

# Observability
SYLTRA_LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=

# Cloud connector — disabled by default (spec §14.11); local control never depends on it.
SYLTRA_CLOUD_ENABLED=false
