# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# standalone sibling projects that sometimes land in this folder —
# not part of the Next.js site, never meant to be committed here.
# New ones keep appearing (and get renamed with the brand); if you add or
# rename a sibling app here, update this list too (a general glob is unsafe —
# it would also hide real subfolders like src/app or public/app).
/syntra-home/
/syltra-home/
/syntra-home-app/
/syltra-home-app/
/syltra-tv-app/
/website/
/system/
/syltra concept/

# typescript
*.tsbuildinfo
next-env.d.ts

# ── SYLTRA Adaptive Edge Platform (Python monorepo) ──

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.python-version.local

# tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# local runtime data (never commit household or broker data)
/platform/data/
/platform/config/home-assistant/.storage/
/platform/config/home-assistant/home-assistant_v2.db*
/platform/config/home-assistant/*.log*
/platform/config/home-assistant/secrets.yaml
/platform/config/home-assistant/.HA_VERSION
/platform/config/home-assistant/blueprints/
/platform/config/home-assistant/deps/
/platform/config/home-assistant/tts/

# model artifacts built locally (exported models are promoted deliberately)
/platform/models/training/**/output/
*.joblib

# secrets and certificates — defense in depth on top of the .env* rule above
*.key
*.crt
*.p12
*.pfx

# Local operator artifacts — never committed
backups/
diagnostics/
