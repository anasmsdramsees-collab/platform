{
  "$id": "https://contracts.syltra.local/1.0/evidence-item.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "One observation supporting a context, with its provenance.",
  "properties": {
    "capability": {
      "title": "Capability",
      "type": "string"
    },
    "device_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Device Id"
    },
    "event_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event Id"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed At"
    },
    "room_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Room Id"
    },
    "status": {
      "default": "KNOWN",
      "title": "Status",
      "type": "string"
    },
    "value": {
      "default": null,
      "title": "Value"
    }
  },
  "required": [
    "capability"
  ],
  "title": "EvidenceItem",
  "type": "object"
}
