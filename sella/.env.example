# Copy to .env and fill in. Never commit the filled copy.
APP_ENV=development
LOG_LEVEL=INFO

# The SYLTRA hub. SELLA reaches the house only through this.
SYLTRA_BASE_URL=http://localhost:8088
SYLTRA_TOKEN=
SYLTRA_HOME_ID=home_dev_001

# mock until a key exists; nothing here has a default value in code
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

DATABASE_URL=postgresql://sella:sella@localhost:5432/sella
REDIS_URL=redis://localhost:6379/0

# Leave these off. The first turns the mocks into real providers; the second
# exposes locks and doors to the model and must wait for the approval system.
MOCK_PROVIDERS=true
ENABLE_HIGH_RISK_TOOLS=false
STORE_RAW_AUDIO=false
