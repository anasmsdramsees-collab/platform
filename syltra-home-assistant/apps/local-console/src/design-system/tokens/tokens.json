{
  "$schema": "https://design-tokens.syltra.local/v1",
  "meta": {
    "name": "SYLTRA Platform Design Tokens",
    "version": "1.0.0",
    "source": "Identity/SYLTRA_Platform_UI_UX_Guidelines.md v1.0",
    "note": "Single source of truth. The CSS files beside this one are generated by scripts/build_tokens.py and checked in; a test fails if they drift."
  },
  "brand": {
    "_note": "SYLTRA palette is Graphite Black, Sand White, Electric Cyan (§6). Green is NOT a brand colour.",
    "graphite": {
      "950": "#080B0D",
      "900": "#0A0D10",
      "850": "#0E1317",
      "800": "#11171C",
      "750": "#151D23",
      "700": "#1C252C",
      "600": "#29343B"
    },
    "sand": {
      "50": "#F7F4EC",
      "100": "#EFEADF",
      "200": "#DDD6C8"
    },
    "cyan": {
      "400": "#59D6E6",
      "500": "#2BC4D9",
      "600": "#169DB0",
      "700": "#0E7281"
    }
  },
  "status": {
    "_note": "Semantic identity hues (§6.2). Green appears here and nowhere else. Each theme restates these as text-safe variants; the dark theme keeps the identity values because they already clear 4.5:1 on dark surfaces.",
    "success": "#22C55E",
    "warning": "#F59E0B",
    "critical": "#EF4444",
    "info": "#3B82F6",
    "unknown": "#7D8A92",
    "offline": "#64727A"
  },
  "theme": {
    "dark": {
      "_note": "Dark is the primary platform experience (§6.3).",
      "background": "#0A0D10",
      "surface": "#11171C",
      "surface-raised": "#151D23",
      "surface-overlay": "#1C252C",
      "border": "#29343B",
      "border-strong": "#62777F",
      "text-primary": "#F7F4EC",
      "text-secondary": "#B5BEC3",
      "text-tertiary": "#89969D",
      "text-disabled": "#647078",
      "accent": "#2BC4D9",
      "accent-hover": "#59D6E6",
      "accent-pressed": "#169DB0",
      "focus-ring": "#59D6E6",
      "_status_note": "Status on dark surfaces — the identity hues, which already pass.",
      "status-success": "#22C55E",
      "status-warning": "#F59E0B",
      "status-critical": "#F87171",
      "status-info": "#60A5FA",
      "status-unknown": "#99A6AE",
      "status-offline": "#829098"
    },
    "light": {
      "background": "#F5F3ED",
      "surface": "#FFFFFF",
      "surface-raised": "#FBFAF7",
      "surface-overlay": "#FFFFFF",
      "border": "#D7D3C9",
      "border-strong": "#8C8474",
      "text-primary": "#11171C",
      "text-secondary": "#4E5A61",
      "text-tertiary": "#626D73",
      "text-disabled": "#7E8B90",
      "accent": "#0E7281",
      "accent-hover": "#169DB0",
      "accent-pressed": "#0A5661",
      "focus-ring": "#0E7281",
      "_status_note": "Status on light surfaces — darkened so text and icons pass 4.5:1.",
      "status-success": "#15803D",
      "status-warning": "#8A5A05",
      "status-critical": "#C81E1E",
      "status-info": "#1259C3",
      "status-unknown": "#5F6B72",
      "status-offline": "#556169"
    }
  },
  "space": {
    "_note": "4px base unit (§8.1).",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "_note": "Sharper than a phone's on purpose: this is an instrument, and the SYLTRA admin surface has always been built at 2/6/16 (§8.2). Pills only for short statuses, filters and compact segmented controls.",
    "sm": "2px",
    "md": "6px",
    "lg": "16px",
    "xl": "20px",
    "round": "999px"
  },
  "elevation": {
    "_note": "Borders before shadows (§8.3). These are for popovers, dialogs, menus and floating drawers only — never a shadow around every card.",
    "none": "none",
    "popover": "0 4px 12px rgba(8, 11, 13, 0.24)",
    "dialog": "0 12px 32px rgba(8, 11, 13, 0.36)",
    "drawer": "0 8px 24px rgba(8, 11, 13, 0.28)"
  },
  "typography": {
    "family": {
      "_note": "§7.1. Families are named first and degrade to system fonts; WOFF2 vendoring is blocked on a licensing decision (see UI_AUDIT C12).",
      "arabic": "'IBM Plex Sans Arabic', 'Noto Sans Arabic', system-ui, sans-serif",
      "latin": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "mono": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "weight": {
      "_note": "No more than three weights (§7.3).",
      "regular": "400",
      "medium": "500",
      "semibold": "600"
    },
    "scale": {
      "display": {
        "size": "32px",
        "line": "40px",
        "weight": "600"
      },
      "page-title": {
        "size": "28px",
        "line": "36px",
        "weight": "600"
      },
      "section-title": {
        "size": "22px",
        "line": "30px",
        "weight": "600"
      },
      "card-title": {
        "size": "18px",
        "line": "26px",
        "weight": "600"
      },
      "body-large": {
        "size": "16px",
        "line": "26px",
        "weight": "400"
      },
      "body": {
        "size": "14px",
        "line": "22px",
        "weight": "400"
      },
      "label": {
        "size": "13px",
        "line": "20px",
        "weight": "500"
      },
      "caption": {
        "size": "12px",
        "line": "18px",
        "weight": "400"
      },
      "metric-large": {
        "size": "32px",
        "line": "38px",
        "weight": "600",
        "numeric": true
      },
      "metric": {
        "size": "20px",
        "line": "26px",
        "weight": "600",
        "numeric": true
      }
    },
    "arabic-line-height-factor": "1.15"
  },
  "motion": {
    "_note": "§19. All motion is suppressed under prefers-reduced-motion.",
    "fast": "120ms",
    "standard": "180ms",
    "slow": "240ms",
    "ease": "cubic-bezier(0.2, 0, 0.2, 1)",
    "ease-out": "cubic-bezier(0, 0, 0.2, 1)"
  },
  "layout": {
    "_note": "§9.2 desktop shell geometry.",
    "sidebar-expanded": "232px",
    "sidebar-collapsed": "72px",
    "topbar-height": "64px",
    "content-padding-inline": "36px",
    "content-padding-block": "28px",
    "grid-columns": "12",
    "grid-gap": "24px",
    "readable-column": "72ch",
    "breakpoint-minimum": "768px",
    "breakpoint-tablet-wide": "900px",
    "breakpoint-desktop": "1200px",
    "breakpoint-desktop-large": "1440px"
  },
  "control": {
    "_note": "§12.1 recommends 44px; §22 requires 24px WCAG minimum. Comfortable is the default (§8.4).",
    "height-comfortable": "44px",
    "height-compact": "36px",
    "height-minimum": "24px",
    "focus-ring-width": "3px",
    "focus-ring-offset": "2px",
    "border-width": "1px"
  },
  "density": {
    "comfortable": {
      "control-height": "44px",
      "row-padding-block": "12px",
      "card-padding": "20px"
    },
    "compact": {
      "control-height": "36px",
      "row-padding-block": "8px",
      "card-padding": "16px"
    }
  }
}
