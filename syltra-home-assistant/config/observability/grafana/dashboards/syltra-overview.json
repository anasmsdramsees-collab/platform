{
  "uid": "syltra-pilot",
  "title": "SYLTRA \u2014 hub overview",
  "description": "Built around the questions a pilot week asks, in the order it asks them. Spec \u00a729's fourteen required metrics all appear here except cloud connector status, whose service does not exist.",
  "tags": [
    "syltra",
    "pilot"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Hub can act on devices",
      "description": "0 during an observe-only pilot. The single most important fact about this hub.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "SYLTRA"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No",
                  "color": "orange",
                  "index": 0
                },
                "1": {
                  "text": "Yes",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "syltra_action_dispatch_enabled",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Confirmed hazards open",
      "description": "A confirmed hazard comes from a certified alarm, never from a model.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "SYLTRA"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(syltra_risk_active_cases{state=\"CONFIRMED\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Advisory risk cases open",
      "description": "Inferred, not confirmed. SYLTRA will not act on these alone.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "SYLTRA"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(syltra_risk_active_cases{state!=\"CONFIRMED\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Devices not reporting",
      "description": "Stale capability states. A quiet home and a home whose sensors stopped look identical without this.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "SYLTRA"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(syltra_twin_stale_capabilities)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cloud connected",
      "description": "Expected to be absent or 0. Local control must not depend on it (invariant 8).",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "SYLTRA"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No",
                  "color": "orange",
                  "index": 0
                },
                "1": {
                  "text": "Yes",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "syltra_cloud_connected",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Events in, last 5m",
      "description": "If this is zero, nothing below means anything.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "SYLTRA"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(syltra_edge_events_received_total[5m]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Policy outcomes",
      "description": "A pilot week of DENY is a very different week from one of ALLOW, and with dispatch off this is the only place the difference shows.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "SYLTRA"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(syltra_policy_decisions_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Actions refused before dispatch",
      "description": "DISPATCH_DISABLED_OBSERVE_ONLY is the pilot posture. MANUAL_OVERRIDE_DETECTED means a person stepped in.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "SYLTRA"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (reason_code) (rate(syltra_action_refusals_total[5m]))",
          "legendFormat": "{{reason_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Recommendations built",
      "description": "What SYLTRA proposed. In observe-only these are the actions that did not happen.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "SYLTRA"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(syltra_adaptive_recommendations_total[5m]))",
          "legendFormat": "recommendations",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Model inference latency",
      "description": "",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "SYLTRA"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(syltra_adaptive_inference_latency_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(syltra_adaptive_inference_latency_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Automations",
      "description": "Why an automation did not run is usually the question, so the skip reasons are here rather than in a log.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "SYLTRA"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(syltra_automation_proposals_total[5m]))",
          "legendFormat": "proposed",
          "refId": "A"
        },
        {
          "expr": "sum by (reason) (rate(syltra_automation_skipped_total[5m]))",
          "legendFormat": "skipped: {{reason}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Event pipeline",
      "description": "A widening gap between these three is where events are being lost.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "SYLTRA"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(syltra_edge_events_received_total[5m]))",
          "legendFormat": "received at the edge",
          "refId": "A"
        },
        {
          "expr": "sum(rate(syltra_edge_events_published_total[5m]))",
          "legendFormat": "published",
          "refId": "B"
        },
        {
          "expr": "sum(rate(syltra_twin_events_applied_total[5m]))",
          "legendFormat": "applied to the twin",
          "refId": "C"
        }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Rejected and duplicate events",
      "description": "Unmapped is the one to watch in a real home: a device whose capability SYLTRA does not recognise.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "SYLTRA"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(syltra_edge_events_invalid_total[5m]))",
          "legendFormat": "invalid at the edge",
          "refId": "A"
        },
        {
          "expr": "sum(rate(syltra_twin_events_invalid_total[5m]))",
          "legendFormat": "invalid at the twin",
          "refId": "B"
        },
        {
          "expr": "sum(rate(syltra_twin_events_duplicate_total[5m]))",
          "legendFormat": "duplicate",
          "refId": "C"
        },
        {
          "expr": "sum(rate(syltra_edge_events_unmapped_total[5m]))",
          "legendFormat": "unmapped capability",
          "refId": "D"
        }
      ]
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "State-update latency",
      "description": "",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "SYLTRA"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(syltra_twin_state_update_latency_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Database latency",
      "description": "",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "SYLTRA"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(syltra_twin_database_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{operation}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Stream consumers connected",
      "description": "A consumer that drops silently is how a home goes quiet without anything appearing to fail.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "SYLTRA"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "syltra_twin_consumer_connected",
          "legendFormat": "digital-twin",
          "refId": "A"
        },
        {
          "expr": "syltra_context_consumer_connected",
          "legendFormat": "context-engine",
          "refId": "B"
        },
        {
          "expr": "syltra_adaptive_consumer_connected",
          "legendFormat": "adaptive-engine",
          "refId": "C"
        },
        {
          "expr": "syltra_edge_connected",
          "legendFormat": "edge-agent",
          "refId": "D"
        }
      ]
    }
  ]
}
