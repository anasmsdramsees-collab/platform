# Copy to /etc/syltra/hub.env, then: sudo chmod 600 /etc/syltra/hub.env
#
# Nothing in this file may ever be committed. `make config-check` fails the
# build if an env file other than an example is tracked.

# Where Home Assistant is. On the same box, this is right as it stands.
HOME_ASSISTANT_URL=http://localhost:8123

# A long-lived access token from Home Assistant:
#   Profile → Security → Long-lived access tokens → Create token
HOME_ASSISTANT_TOKEN=

# What this house is called in the platform. Anything stable; it appears in the
# audit trail and in every event.
SYLTRA_HOME_ID=home_001
SYLTRA_HUB_ID=hub_001

# `development` blocks every life-safety actuator (valves, breakers, sirens) —
# the right setting for a hub on a bench with nothing dangerous wired to it.
# Change it only when the hub is in a house and you mean it.
SYLTRA_ENVIRONMENT=development

# The household's own clock. A person who writes "7pm" means 7pm here.
SYLTRA_TIMEZONE=Asia/Riyadh

SYLTRA_HUB_PORT=8088
SYLTRA_LOG_LEVEL=INFO
